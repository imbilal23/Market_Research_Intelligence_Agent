# ============================================================
# Market Research Intelligence Agent — Environment Template
# ============================================================
# Copy to .env and fill in your real values before running.
# When deploying to Railway, set these as Railway environment variables.

# ----- Google Gemini (Primary LLM & Embedding Provider) -----
# Obtain from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-3.5-flash-lite
EMBEDDING_MODEL=models/gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# ----- External Tool API Key -----
TAVILY_API_KEY=

# ----- Auth & JWT -----

# Generate a private value with python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRY_MINS=1500
REFRESH_TOKEN_EXPIRY_DAYS=1

# ----- Backend Server Binding -----
# Railway sets PORT automatically. HOST should be 0.0.0.0 for Railway/Docker.
HOST=0.0.0.0
PORT=8000

# ----- CORS -----
# Optional public frontend origin. Streamlit calls the private API server-side.
# For fully open (development), use ["*"]
# CORS_ORIGINS=["https://your-frontend.up.railway.app"]

# ----- Persistent SQLite Storage (Railway Volume) -----
# Mount the volume on backend. Set DATA_DIR as a Railway service variable.
# DATA_DIR=/data
# Optional individual overrides:
# SQLITE_APP_DB_PATH=/data/app.db
# SQLITE_CHECKPOINTER_PATH=/data/checkpoints.db
# SQLITE_VECTOR_DB_PATH=/data/vectors.db
# UPLOAD_DIR=/data/uploads

# ----- Frontend (Railway service variables) -----
# Set PORT separately per Railway service. Set this URL on frontend in Railway:
# BACKEND_BASE_URL=http://${{backend.RAILWAY_PRIVATE_DOMAIN}}:${{backend.PORT}}/api/v1
